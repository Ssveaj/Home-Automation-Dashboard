    private void AddPlace(PlaceSuggestion place)
    {
        draft.OpenWeather.Cities.Add(new CityOptions
        {
            Key = NewKey("plats"),
            DisplayName = place.Name,
            Query = place.Query,
            TimeZone = place.TimeZoneId,
        });

        if (!zones.Any(z => z.Id == place.TimeZoneId))
        {
            zones = [.. zones.Append(Describe(place.TimeZoneId)).OrderBy(z => z.Label, StringComparer.CurrentCulture)];
        }

        searchResults = [];
        searchTerm = string.Empty;
        searchMessage = null;
    }

