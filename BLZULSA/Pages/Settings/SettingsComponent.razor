    private void LeaveKiosk()
    {
        confirmLeave = false;

        if (gate is not { IsUnlocked: true })
        {
            status = "Inställningarna är låsta.";
            failed = true;
            return;
        }

        if (!Kiosk.IsAvailable)
        {
            status = "Lämna tavlan fungerar bara på Raspberry Pi:n.";
            failed = true;
            return;
        }

        if (Kiosk.TryPause())
        {
            status = "Tavlan stängs. Den kommer tillbaka av sig själv om " + KioskPause.Duration.TotalMinutes.ToString("0") + " minuter.";
            failed = false;
        }
        else
        {
            status = "Kunde inte lämna tavlan. Se Hälsa.";
            failed = true;
        }
    }

    private async Task Save()
    {
        if (gate is not { IsUnlocked: true })
        {
            status = "Inställningarna är låsta. Inget sparat.";
            failed = true;
            return;
        }

        saving = true;
        status = null;

        try
        {
            Normalize(draft);

            if (Store.LastWriteUtc > draftLoadedAt)
            {
                status = "Inställningarna har ändrats någon annanstans sedan du öppnade sidan. Tryck Återställ för att hämta dem, annars skrivs de över. Inget sparat.";
                failed = true;
                return;
            }

            if (MissingRequired() is { Count: > 0 } missing)
            {
                status = $"Måste fyllas i: {string.Join(", ", missing)}. Inget sparat.";
                failed = true;
                return;
            }

            var badZones = draft.OpenWeather.Cities.Where(c => !TimeZoneCache.Exists(c.TimeZone)).Select(c => c.DisplayName).ToList();
            if (badZones.Count > 0)
            {
                status = $"Okänd tidszon för {string.Join(", ", badZones)}. Inget sparat.";
                failed = true;
                return;
            }

            await Store.SaveAsync(draft);
            draftLoadedAt = Store.LastWriteUtc;
            Refresh.Trigger();
            status = "Sparat.";
            failed = false;
        }
        catch (Exception ex) when (ex is IOException or UnauthorizedAccessException)
        {
            status = $"Kunde inte spara: {ex.Message}";
            failed = true;
        }
        finally
        {
            saving = false;
        }
    }

    private static void Normalize(DashboardOptions settings)
    {
        settings.OpenWeather.Cities.RemoveAll(c => string.IsNullOrWhiteSpace(c.DisplayName));
        settings.Shelly.Lights.RemoveAll(l => string.IsNullOrWhiteSpace(l.Name));
        settings.Shelly.Sensors.RemoveAll(s => string.IsNullOrWhiteSpace(s.DisplayName));
        settings.InterestRates.Series.RemoveAll(r => string.IsNullOrWhiteSpace(r.SeriesId));

        foreach (var school in settings.SchoolMenu.Schools)
        {
            school.Slug = SchoolMenuService.NormalizeSlug(school.Slug);
            school.Name = school.Name.Trim();
        }

        settings.SchoolMenu.Schools.RemoveAll(x => x.Slug.Length == 0);

        if (settings.OpenWeather.Cities.Count > 0
            && !settings.OpenWeather.Cities.Any(c => c.IsPrimary))
        {
            settings.OpenWeather.Cities[0].IsPrimary = true;
        }
    }

