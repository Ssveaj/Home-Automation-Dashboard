    private static string NewKey(string prefix) => $"{prefix}-{Guid.NewGuid().ToString("n")[..8]}";

    private List<string> MissingRequired()
    {
        var missing = new List<string>();

        if (string.IsNullOrWhiteSpace(draft.HomeName)) { missing.Add("Startsidans namn"); }
        if (string.IsNullOrWhiteSpace(draft.News.Url)) { missing.Add("Nyhetsflöde"); }
        if (string.IsNullOrWhiteSpace(draft.GasolinePrice.Url)) { missing.Add("Drivmedelsadress"); }

        foreach (var city in draft.OpenWeather.Cities)
        {
            var label = string.IsNullOrWhiteSpace(city.DisplayName) ? "en plats" : city.DisplayName;

            if (string.IsNullOrWhiteSpace(city.DisplayName)) { missing.Add("Namn på en plats"); }
            if (string.IsNullOrWhiteSpace(city.Query)) { missing.Add($"Vädersökning för {label}"); }
            if (string.IsNullOrWhiteSpace(city.TimeZone)) { missing.Add($"Tidszon för {label}"); }
        }

        return missing;
    }

