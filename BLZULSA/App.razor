
<!DOCTYPE html>
<html lang="sv">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#07090F" />
    <base href="/" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@200;300;400;500;600&display=swap" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" />
    <link rel="stylesheet" href="@Assets["css/site.css"]" />
    <link rel="stylesheet" href="@Assets["BLZULSA.styles.css"]" />

    <HeadOutlet @rendermode="InteractiveServer" />
</head>
<body>
    <Routes @rendermode="InteractiveServer" />
    <div id="components-reconnect-modal" class="reconnect-overlay">
        <div class="reconnect-message">
            <span class="reconnect-spinner"></span>
            <span>Återansluter…</span>
        </div>
    </div>

    <div id="blazor-error-ui">
        Ett fel har inträffat. Sidan kan behöva laddas om.
        <a href="" class="reload">Ladda om</a>
        <a class="dismiss">🗙</a>
    </div>

    <script src="_framework/blazor.web.js"></script>
    <script src="@Assets["js/reconnect.js"]"></script>
    <script src="@Assets["js/keyboard.js"]"></script>
    <script src="@Assets["js/dimmer.js"]"></script>
</body>
</html>
